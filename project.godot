; Lowtide Vigil — Linux-first Milestone 1.
config_version=5

[application]
config/name="Lowtide Vigil"
run/main_scene="res://scenes/vigil.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Carry the vigil lantern into the abbey before the tide returns."

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.028, 0.07, 1)

